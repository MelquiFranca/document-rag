DATABASE_URL=postgresql://postgres:postgres@localhost:5435/evidence_auditor
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5435/evidence_auditor_test

# openai | ollama
AI_PROVIDER=ollama
EMBEDDING_DIMENSIONS=768

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=gemma3:4b
OLLAMA_EMBEDDING_MODEL=embeddinggemma

# Optional: enables monetary estimates for OpenAI runs.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
